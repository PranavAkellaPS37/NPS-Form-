    if (rec.ratings === 1) {
      out.ratings.push({ block: 'question', item: step.id, rating: v, not_applicable: false,
        threshold: null, below_threshold: null, issue_code: null });
    }
  }

  /* ---- The 13 built-in kinds: exactly the old behaviour (docs/flow-engine.md 3;
