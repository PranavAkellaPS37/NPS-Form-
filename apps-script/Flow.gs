      tests.forEach(function (t) { var v = t.leaf.cond[t.leaf.test]; (Array.isArray(v) ? v : [v]).forEach(function (x) { if (isScalar(x) && rounds.indexOf(String(x)) === -1) rounds.push(String(x)); }); });
