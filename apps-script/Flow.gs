    if (!m.startEntry || c.findings.some(function (f) { return f.level === 'error'; })) return;
    var sets = answerSets(m, { cap: WALK_CAP, seed: 7 });
    var shown = {};
    var nodes = m.entries.map(function (e) { return e.node; });
    var failed = false;
    sets.list.forEach(function (set) {
      if (failed) return;
