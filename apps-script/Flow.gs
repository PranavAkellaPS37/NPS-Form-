      var cands = factCandidates(m, f, factTests[f] || []);
      var reps = factTests[f] ? representatives(F, cands, factTests[f], function (cand) { var fx = {}; fx[f] = cand.f; return { scope: {}, facts: fx }; }) : [cands[0]];
      dims.push({ fact: f, values: reps });
