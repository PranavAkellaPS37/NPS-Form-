  }
  function langName(code) { return (own(LANG_NAMES, code) || code) + ' (' + code + ')'; }

  /* ---- sizes: stats, D3, D4 ------------------------------------------------- */
  /* What one screen adds to the message: its kind's "records" in the catalogue
