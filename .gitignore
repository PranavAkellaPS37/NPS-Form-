# =============================================================================
# .gitignore: files git must NEVER commit.
#
# Rule #1 of this project: NO real partner data in the repository.
# So, by default, we ignore every file type that could hold real data
# (spreadsheets, exports, voice notes, logs, keys). The only exception is
# the obviously-fake demo data in /sample_data, which is re-allowed at the end.
#
# Before every commit you can double-check with:   git status --ignored
# =============================================================================

# --- Local data written by the mock server, pipeline and dashboard ---------
local_data/
data/
exports/
logs/
pipeline/audio/
pipeline/cache/
pipeline/review/gold*.csv
dashboard/cache/

# --- Anything that looks like a data export --------------------------------
*.csv
*.tsv
*.xlsx
*.xls
*.jsonl
*.parquet
*.sqlite
*.db
# ...except the fake test tables of "Paste a route" (made-up questions, no partner data;
# tests/flow/route_table_test.js needs them).
!tests/flow/fixtures/route-table/*.csv
!tests/flow/fixtures/route-table/*.tsv

# --- Voice recordings (partner voices are personal data) -------------------
# Note: web/audio/*.mp3 (our own pre-recorded question clips) is NOT ignored.
*.webm
*.ogg
*.opus
*.m4a
*.wav
*.aac
*.mp4
*.bin

# --- Secrets: API keys, Google credentials, tokens --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
client_secret*.json
service_account*.json
service-account*.json
token*.json
.clasprc.json
# clasp's link to one person's Apps Script project (the optional developer
# route in apps-script/README.md keeps it outside this folder). Not a
# password, but personal to each admin: never upload it if one appears here.
.clasp.json

# --- Python / Node / Mac clutter --------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
.streamlit/secrets.toml

# --- Developer tests (tests/): what the suites write while they run ---------
# Screenshots, the test server's fake data, reports and downloads. Made
# again on every run, so never committed. (tests/node_modules/ is covered by
# node_modules/ above.)
tests/e2e/shots/
tests/e2e/data-*/
tests/gas-harness/out/
tests/panel/shots/
tests/panel/downloads/
tests/model/checkcopy/
tests/model/strict/run-*/

# --- Re-allow the FAKE demo data (never put real data in here) --------------
!sample_data/
!sample_data/**

# --- Claude Code: personal settings and the status-page guard ---------------
# Local to Pranav's Mac (hooks that keep the colleague status page updated,
# and its activity log). Never committed.
.claude/settings.local.json
.claude/status/
