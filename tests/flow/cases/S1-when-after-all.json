{
 "_about": "Graph format: the flow asks each problem screen straight after its own rating (a group per area), but survey.json's deep_dive > when is \"after_all_ratings\".",
 "base": "graph",
 "patch": [
  {
   "op": "remove",
   "node": "fn_deep_dives"
  },
  {
   "op": "replace",
   "node": "fn_ratings",
   "value": {
    "id": "area_loop",
    "type": "group",
    "repeat_for": {
     "each": "area",
     "in": "areas"
    },
    "body": {
     "start": "fn_ratings",
     "nodes": [
      {
       "id": "fn_ratings",
       "type": "function_rating",
       "store_as": "fn_rating:{area}",
       "text": "q.fn_rating",
       "label": "fn.{area}.name",
       "help": "fn.{area}.help",
       "allow_not_applicable": true,
       "issue_code_from": "fn_deep_dive:{area}",
       "next": "fn_deep_dives"
      },
      {
       "id": "fn_deep_dives",
       "type": "function_deep_dive",
       "store_as": "fn_deep_dive:{area}",
       "text": "q.deep_dive",
       "label": "fn.{area}.name",
       "rating_from": "fn_rating:{area}",
       "options": {
        "from": "area.issues",
        "text": "issue.{area}.{code}",
        "other": "issue.other"
       },
       "detail_text": "q.tell_more",
       "detail_text_required": "q.tell_more_required",
       "require_choice": true,
       "require_detail_if_other": true,
       "next": "@next_item",
       "show_if": {
        "answer": "fn_rating:{area}",
        "at_most": {
         "var": "area.threshold"
        }
       }
      }
     ]
    },
    "next": "support_gate"
   }
  },
  {
   "op": "set",
   "node": "nps",
   "field": "next",
   "value": "area_loop"
  }
 ],
 "expect": [
  {
   "code": "S1",
   "level": "error",
   "node": "area_loop"
  }
 ]
}
